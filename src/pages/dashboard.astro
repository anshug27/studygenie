---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Dashboard - StudyGenie" description="Your study dashboard. View history, saved flashcards, quizzes, and summaries.">
  <section class="max-w-4xl mx-auto px-4 py-12">

    <!-- Loading state -->
    <div id="loading-state" class="text-center py-20">
      <div class="spinner-dark mx-auto mb-4"></div>
      <p style="color: var(--text-muted);">Loading your dashboard...</p>
    </div>

    <!-- Not logged in -->
    <div id="not-logged-in" class="hidden text-center py-20">
      <span class="text-5xl">🔒</span>
      <h1 class="text-2xl font-bold mt-4 mb-2" style="color: var(--text);">Sign in to access your dashboard</h1>
      <p class="mb-6" style="color: var(--text-muted);">Save your study history across devices and get 10 free AI uses per day.</p>
      <a href="/login" class="btn btn-brand btn-lg">Sign In</a>
    </div>

    <!-- Dashboard content -->
    <div id="dashboard" class="hidden">
      <!-- User header -->
      <div class="flex items-center justify-between mb-8">
        <div class="flex items-center gap-4">
          <div id="user-avatar" class="w-14 h-14 rounded-full flex items-center justify-center text-xl font-bold" style="background: rgba(99,102,241,0.1); color: #6366f1;"></div>
          <div>
            <h1 class="text-xl font-bold" style="color: var(--text);" id="user-name">Student</h1>
            <p class="text-sm" style="color: var(--text-muted);" id="user-email">email@example.com</p>
          </div>
        </div>
        <button type="button" data-logout class="btn btn-outline btn-sm">Log Out</button>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="card text-center">
          <p class="text-2xl font-bold" style="color: #6366f1;" id="stat-total">0</p>
          <p class="text-xs" style="color: var(--text-muted);">Total Uses</p>
        </div>
        <div class="card text-center">
          <p class="text-2xl font-bold" style="color: #10b981;" id="stat-remaining">10</p>
          <p class="text-xs" style="color: var(--text-muted);">Uses Left Today</p>
        </div>
        <div class="card text-center">
          <p class="text-2xl font-bold" style="color: #f59e0b;" id="stat-saved">0</p>
          <p class="text-xs" style="color: var(--text-muted);">Saved Items</p>
        </div>
        <div class="card text-center">
          <p class="text-sm font-bold" style="color: var(--text);" id="stat-plan">Free</p>
          <p class="text-xs" style="color: var(--text-muted);">Plan</p>
        </div>
      </div>

      <!-- Quick Tools -->
      <div class="mb-8">
        <h2 class="text-lg font-bold mb-4" style="color: var(--text);">Quick Start</h2>
        <div class="grid grid-cols-3 md:grid-cols-5 gap-3">
          <a href="/tools/summarize" class="card text-center py-4 no-underline hover:shadow-md transition-shadow">
            <span class="text-2xl">📝</span>
            <p class="text-xs font-medium mt-1" style="color: var(--text);">Summarize</p>
          </a>
          <a href="/tools/flashcards" class="card text-center py-4 no-underline hover:shadow-md transition-shadow">
            <span class="text-2xl">🃏</span>
            <p class="text-xs font-medium mt-1" style="color: var(--text);">Flashcards</p>
          </a>
          <a href="/tools/quiz" class="card text-center py-4 no-underline hover:shadow-md transition-shadow">
            <span class="text-2xl">🧪</span>
            <p class="text-xs font-medium mt-1" style="color: var(--text);">Quiz</p>
          </a>
          <a href="/tools/math" class="card text-center py-4 no-underline hover:shadow-md transition-shadow">
            <span class="text-2xl">🔢</span>
            <p class="text-xs font-medium mt-1" style="color: var(--text);">Math</p>
          </a>
          <a href="/tools/planner" class="card text-center py-4 no-underline hover:shadow-md transition-shadow">
            <span class="text-2xl">📅</span>
            <p class="text-xs font-medium mt-1" style="color: var(--text);">Planner</p>
          </a>
        </div>
      </div>

      <!-- History filter -->
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold" style="color: var(--text);">Study History</h2>
        <select id="history-filter" class="input" style="width: auto; padding: 0.4rem 0.8rem; font-size: 0.8rem;">
          <option value="all">All Types</option>
          <option value="summary">Summaries</option>
          <option value="flashcards">Flashcards</option>
          <option value="quiz">Quizzes</option>
          <option value="explain">Explanations</option>
          <option value="math">Math</option>
          <option value="essay">Essays</option>
          <option value="planner">Plans</option>
          <option value="notes">Notes</option>
          <option value="youtube">YouTube</option>
        </select>
      </div>

      <!-- History list -->
      <div id="history-list">
        <div class="text-center py-12" style="color: var(--text-muted);">
          <span class="text-4xl">📚</span>
          <p class="mt-3">No study history yet. Start using any tool to see your history here!</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { onAuthChange, getCurrentUser, getUserStats, getStudyHistory, getStudyHistoryByType } from '../utils/auth';

    function init() {
      const loadingState = document.getElementById('loading-state')!;
      const notLoggedIn = document.getElementById('not-logged-in')!;
      const dashboard = document.getElementById('dashboard')!;

      document.getElementById('history-filter')!.addEventListener('change', (e) => {
        loadHistory((e.target as HTMLSelectElement).value);
      });

      onAuthChange(async (user) => {
        loadingState.classList.add('hidden');

        if (!user) {
          notLoggedIn.classList.remove('hidden');
          dashboard.classList.add('hidden');
          return;
        }

        notLoggedIn.classList.add('hidden');
        dashboard.classList.remove('hidden');

        // Set user info
        const nameEl = document.getElementById('user-name')!;
        const emailEl = document.getElementById('user-email')!;
        const avatarEl = document.getElementById('user-avatar')!;

        nameEl.textContent = user.displayName || 'Student';
        emailEl.textContent = user.email || '';

        if (user.photoURL) {
          avatarEl.innerHTML = `<img src="${user.photoURL}" class="w-14 h-14 rounded-full" alt="avatar" />`;
        } else {
          avatarEl.textContent = (user.displayName || user.email || 'S')[0].toUpperCase();
        }

        // Load stats
        try {
          const stats = await getUserStats(user);
          const today = new Date().toISOString().split('T')[0];
          const maxDaily = stats.plan === 'pro' ? 999 : 10;
          const usedToday = stats.lastUseDate === today ? stats.dailyUses : 0;

          document.getElementById('stat-total')!.textContent = String(stats.totalUses);
          document.getElementById('stat-remaining')!.textContent = stats.plan === 'pro' ? '∞' : String(Math.max(0, maxDaily - usedToday));
          document.getElementById('stat-plan')!.textContent = stats.plan === 'pro' ? 'Pro' : 'Free';
        } catch {}

        // Load history
        await loadHistory('all');
      });

      async function loadHistory(type: string) {
        const user = getCurrentUser();
        if (!user) return;

        const listEl = document.getElementById('history-list')!;
        listEl.innerHTML = '<div class="text-center py-8"><div class="spinner-dark mx-auto"></div></div>';

        try {
          const items = type === 'all'
            ? await getStudyHistory(user, 30)
            : await getStudyHistoryByType(user, type, 30);

          document.getElementById('stat-saved')!.textContent = String(items.length);

          if (items.length === 0) {
            listEl.innerHTML = `
              <div class="text-center py-12" style="color: var(--text-muted);">
                <span class="text-4xl">📚</span>
                <p class="mt-3">No ${type === 'all' ? 'study' : type} history yet. Start using any tool!</p>
              </div>`;
            return;
          }

          const typeIcons: Record<string, string> = {
            summary: '📝', flashcards: '🃏', quiz: '🧪', explain: '💡',
            youtube: '🎬', math: '🔢', essay: '✍️', planner: '📅', notes: '📒',
          };

          const typeColors: Record<string, string> = {
            summary: '#6366f1', flashcards: '#10b981', quiz: '#f59e0b', explain: '#ec4899',
            youtube: '#ef4444', math: '#3b82f6', essay: '#8b5cf6', planner: '#14b8a6', notes: '#f97316',
          };

          listEl.innerHTML = items.map(item => {
            const icon = typeIcons[item.type] || '📄';
            const color = typeColors[item.type] || '#6366f1';
            const date = item.createdAt?.toDate?.() ? new Date(item.createdAt.toDate()).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '';
            const preview = item.input?.slice(0, 100) || item.title || '';
            return `
              <div class="card mb-3" style="padding: 1rem;">
                <div class="flex items-start gap-3">
                  <div class="text-xl flex-shrink-0">${icon}</div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-xs font-semibold px-2 py-0.5 rounded-full" style="background: ${color}20; color: ${color};">${item.type}</span>
                      <span class="text-xs" style="color: var(--text-muted);">${date}</span>
                    </div>
                    <p class="text-sm font-medium truncate" style="color: var(--text);">${escapeHtml(item.title || preview)}</p>
                    <p class="text-xs truncate" style="color: var(--text-muted);">${escapeHtml(preview)}</p>
                  </div>
                </div>
              </div>`;
          }).join('');
        } catch (e) {
          listEl.innerHTML = `<p class="text-center py-8 text-sm" style="color: var(--text-muted);">Failed to load history.</p>`;
        }
      }

      function escapeHtml(str: string) {
        return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }
    }

    init();
  </script>
</Layout>
